{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/learn_signal.py\"", "timeout": 5},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/recall_hook.py\"", "timeout": 10}
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"", "timeout": 5}
        ]
      }
    ]
  }
}
